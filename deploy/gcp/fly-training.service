[Unit]
Description=Fruit Fly shared training coordinator
After=network.target

[Service]
Type=simple
User=flytraining
Group=flytraining
EnvironmentFile=/etc/fly-training/service.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u /opt/fly-training/current/server/launcher.py
WorkingDirectory=/opt/fly-training/current
StateDirectory=fly-training
StateDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/fly-training
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=256M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
